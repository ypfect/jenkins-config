def REGISTRY = 'localhost:5050'
def IMAGE_NAME = 'appx'
def BUILD_SERVICE = 'appx'
def CONFIG_REPO = 'https://github.com/ypfect/jenkins-config.git'
def BUILD_REPO = 'https://github.com/ypfect/77core-apps-build.git'
def STEPS = 'python3 -u pipeline/appx/scripts/apps-build-steps.py'
def DB_CONFIG = 'postgres.local-db-config.json'

pipeline {
  agent none

  parameters {
    string(name: 'Branch', defaultValue: 'master', description: 'apps/build 分支（77core-apps-build）')
    string(name: 'Env', defaultValue: 'local', description: '目标环境')
    string(name: 'deployID', defaultValue: '', description: '部署任务号')
  }

  environment {
    REGISTRY = "${REGISTRY}"
    IMAGE_NAME = "${IMAGE_NAME}"
    BUILD_SERVICE = "${BUILD_SERVICE}"
    IMAGE = "${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"
    DEPLOY_ENV = "${params.Env}"
    deployID = "${params.deployID}"
    Branch = "${params.Branch}"
    DBFILES = "${DB_CONFIG}"
  }

  stages {
    stage('初始化变量') {
      agent { label 'built-in' }
      steps {
        dir('pipeline') { git url: CONFIG_REPO, branch: 'main', changelog: false }
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}" Branch="\${Branch}" BUILD_NUMBER="\${BUILD_NUMBER}" BUILD_SERVICE="\${BUILD_SERVICE}"
          ${STEPS} --Module=getAppx --Env="\${DEPLOY_ENV}"
          ${STEPS} --Module=getDbConfig --Env="\${DEPLOY_ENV}"
        """
      }
    }

    stage('检查是否满足运行要求') {
      agent { label 'built-in' }
      steps {
        sh """
          export Env="\${DEPLOY_ENV}" Branch="\${Branch}" DBfiles="\${DBFILES}"
          ${STEPS} --Module=checkTask --Env="\${DEPLOY_ENV}" --Branch="\${Branch}"
          ${STEPS} --Module=insertDbinfo --Env="\${DEPLOY_ENV}" --DBfiles="\${DBFILES}" \\
            --DBHost=postgres --DBPort=5432 --DBUser=postgres --DBPswd=123
          ${STEPS} --Module=initEnvDbs --Env="\${DEPLOY_ENV}" --DBfiles="\${DBFILES}"
        """
      }
    }

    stage('创建testapp数据库') {
      agent { label 'built-in' }
      steps {
        sh """
          export Env="\${DEPLOY_ENV}"
          ${STEPS} --Module=createdb
        """
      }
    }

    stage('拉取代码/打包') {
      agent {
        docker {
          image 'maven:3.9-eclipse-temurin-21'
          args '-u root -v maven-m2:/root/.m2/repository'
        }
      }
      steps {
        dir('pipeline') { git url: CONFIG_REPO, branch: 'main', changelog: false }
        dir('apps_src') {
          git url: BUILD_REPO, branch: params.Branch
        }
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}" Branch="\${Branch}" BUILD_NUMBER="\${BUILD_NUMBER}" BUILD_SERVICE="\${BUILD_SERVICE}"
          ${STEPS} --Module=callbackLog --deployID="\${deployID}" --log_info="开始拉取 apps/build 并 build3.py -a appx"
          ${STEPS} --Module=prepareBuild
          ${STEPS} --Module=build
        """
        stash includes: 'apps_src/**', name: 'artifacts'
      }
    }

    stage('后台服务数据库升级脚本制作') {
      agent { label 'built-in' }
      steps {
        unstash 'artifacts'
        sh """
          export Env="\${DEPLOY_ENV}" DBfiles="\${DBFILES}"
          ${STEPS} --Module=genUpgradeScript --Env="\${DEPLOY_ENV}" --DBfiles="\${DBFILES}" \\
            --DbtoolsPath="\${WORKSPACE}/apps_src/result/dbtools/"
        """
      }
    }

    stage('基准库校验-应用api-buildtime') {
      agent { label 'built-in' }
      steps {
        sh "${STEPS} --Module=checkDbBuildtime --Env=\"\${DEPLOY_ENV}\""
      }
    }

    stage('停服务/备份数据库') {
      agent { label 'built-in' }
      steps {
        unstash 'artifacts'
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}" DBfiles="\${DBFILES}"
          ${STEPS} --Module=callbackLog --log_info="停服务+备份（mock）"
          ${STEPS} --Module=restartSvc --Env="\${DEPLOY_ENV}" --Svclist=appx --Operate=stop
          ${STEPS} --Module=backupdb --Env="\${DEPLOY_ENV}" --DBfiles="\${DBFILES}"
        """
      }
    }

    stage('开始数据库操作') {
      agent { label 'built-in' }
      steps {
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}"
          ${STEPS} --Module=updateWeatherPause --deployID="\${deployID}" --weather_pause=False
        """
      }
    }

    stage('Tenant库数据库升级/基准库创建') {
      agent { label 'built-in' }
      steps {
        unstash 'artifacts'
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}" BUILD_NUMBER="\${BUILD_NUMBER}" DBfiles="\${DBFILES}"
          ${STEPS} --Module=callbackLog --log_info="Tenant库三段式升级"
          ${STEPS} --Module=doSqlUpdate --SqlPhase=before --DBfiles="\${DBFILES}"
          ${STEPS} --Module=doSqlUpdate --SqlPhase=dbtools --DBfiles="\${DBFILES}"
          ${STEPS} --Module=doSqlUpdate --SqlPhase=after --DBfiles="\${DBFILES}"
          ${STEPS} --Module=createBaseDb --DbType=tenant --DBfiles="\${DBFILES}"
        """
      }
    }

    stage('打镜像') {
      agent { label 'built-in' }
      steps {
        unstash 'artifacts'
        sh """
          export REGISTRY="\${REGISTRY}" IMAGE_NAME="\${IMAGE_NAME}" BUILD_NUMBER="\${BUILD_NUMBER}"
          ${STEPS} --Module=dockerBuild
        """
      }
    }

    stage('推镜像') {
      agent { label 'built-in' }
      steps {
        sh """
          export REGISTRY="\${REGISTRY}" IMAGE_NAME="\${IMAGE_NAME}" BUILD_NUMBER="\${BUILD_NUMBER}"
          ${STEPS} --Module=dockerPush
        """
      }
    }
  }

  post {
    success {
      node('built-in') {
        dir('pipeline') { git url: CONFIG_REPO, branch: 'main', changelog: false }
        echo "appx CI 完成。镜像: ${env.IMAGE}"
        echo "产物目录: apps_src/result/（对标公司 apps/build）"
        echo "下一步: ./practice/trigger-appx-deploy.sh --image ${env.IMAGE} --env ${params.Env} --deploy-id ${params.deployID}"
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          unstash 'artifacts'
          archiveArtifacts artifacts: 'apps_src/result/**', fingerprint: true, allowEmptyArchive: true
        }
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}" Branch="\${Branch}" BUILD_NUMBER="\${BUILD_NUMBER}" IMAGE="\${IMAGE}" JOB_TYPE=ci STATUS=SUCCESS
          ${STEPS} --Module=writeStatus --taskStatus=SUCCESS --deployID="\${deployID}" --buildID="\${BUILD_NUMBER}"
        """
      }
    }
    failure {
      node('built-in') {
        dir('pipeline') { git url: CONFIG_REPO, branch: 'main', changelog: false }
        sh """
          export Env="\${DEPLOY_ENV}" deployID="\${deployID}" Branch="\${Branch}" BUILD_NUMBER="\${BUILD_NUMBER}" JOB_TYPE=ci STATUS=FAILURE
          ${STEPS} --Module=writeStatus --taskStatus=FAILURE --deployID="\${deployID}" --buildID="\${BUILD_NUMBER}"
        """
      }
    }
  }
}
