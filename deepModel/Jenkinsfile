def REGISTRY = 'localhost:5050'
def IMAGE_NAME = 'deepmodel'
def APP_REPO = 'https://github.com/ypfect/deepModel.git'
def CONFIG_REPO = 'https://github.com/ypfect/jenkins-config.git'

pipeline {
  agent none

  parameters {
    string(name: 'BRANCH', defaultValue: 'main', description: '业务代码分支')
    string(name: 'Env', defaultValue: 'local', description: '目标环境（对标公司 Env 参数）')
    string(name: 'deployID', defaultValue: '', description: '部署任务号（对标公司 deployID）')
  }

  environment {
    REGISTRY = "${REGISTRY}"
    IMAGE_NAME = "${IMAGE_NAME}"
    IMAGE = "${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"
    PIPELINE_DIR = "${WORKSPACE}/pipeline"
    Env = "${params.Env}"
    deployID = "${params.deployID}"
    BRANCH = "${params.BRANCH}"
  }

  stages {
    stage('Init') {
      agent { label 'built-in' }
      steps {
        dir('pipeline') {
          git url: CONFIG_REPO, branch: 'main', changelog: false
        }
        sh '''
          export Env="${Env}" deployID="${deployID}" BRANCH="${BRANCH}" BUILD_NUMBER="${BUILD_NUMBER}"
          pipeline/deepModel/scripts/ci-steps.sh logInit
        '''
      }
    }

    stage('Build') {
      agent {
        docker {
          image 'maven:3.9-eclipse-temurin-21'
          args '-u root -v maven-m2:/root/.m2/repository'
        }
      }
      stages {
        stage('Checkout') {
          steps {
            git url: APP_REPO, branch: params.BRANCH
          }
        }
        stage('Package') {
          steps {
            sh 'pipeline/deepModel/scripts/ci-steps.sh package'
            stash includes: 'target/**,Dockerfile,.dockerignore', name: 'artifacts'
          }
        }
      }
    }

    stage('Docker') {
      agent { label 'built-in' }
      steps {
        unstash 'artifacts'
        sh 'pipeline/deepModel/scripts/ci-steps.sh dockerBuild'
      }
    }

    stage('Push') {
      agent { label 'built-in' }
      steps {
        sh 'pipeline/deepModel/scripts/ci-steps.sh dockerPush'
      }
    }
  }

  post {
    success {
      node('built-in') {
        echo "CI 完成。镜像: ${env.IMAGE}"
        echo "下一步: 触发 deepModel-deploy，参数 IMAGE=${env.IMAGE} Env=${params.Env} deployID=${params.deployID}"
        echo "或运行: practice/trigger-deploy.sh --image ${env.IMAGE} --env ${params.Env} --deploy-id ${params.deployID}"
        unstash 'artifacts'
        archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        sh '''
          export Env="${Env}" deployID="${deployID}" BRANCH="${BRANCH}" BUILD_NUMBER="${BUILD_NUMBER}" IMAGE="${IMAGE}" STATUS=SUCCESS
          pipeline/deepModel/scripts/ci-steps.sh writeStatus
        '''
      }
    }
    failure {
      node('built-in') {
        sh '''
          export Env="${Env}" deployID="${deployID}" BRANCH="${BRANCH}" BUILD_NUMBER="${BUILD_NUMBER}" STATUS=FAILURE
          [ -f pipeline/deepModel/scripts/ci-steps.sh ] && pipeline/deepModel/scripts/ci-steps.sh writeStatus || true
        '''
      }
    }
  }
}
